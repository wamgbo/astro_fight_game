<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Box Fight System - Synchronized Animation Fix</title>

		<style>
			html,
			body {
				margin: 0;
				height: 100%;
				background: #222; /* 換成深色背景，更容易檢查圖片去背是否完美 */
				display: flex;
				justify-content: center;
				align-items: center;
				font-family: sans-serif;
			}

			.game-board {
				position: relative;
				width: 1200px;
				height: 700px;
				background: url(src/bg.png);
				/* background: #f4f4f4; */
				border: 3px solid #2ecc71;
				overflow: hidden;
			}

			/* ========================================== */
			/* 角色基礎樣式 (完美支援去背 PNG) */
			/* ========================================== */
			.box {
				width: 400px;
				height: 1000px;

				position: absolute;

				background-repeat: no-repeat;
				background-position: center;
				background-size: contain;
			}
			.hitbox {
				position: absolute;

				width: 140px;
				height: 320px;

				left: 135px;
				top: 340px;

				/* background: rgba(255, 0, 0, 0.2); */
			}
			/* ========================================== */
			/* 攻擊判定盒 (可隨時換成去背的斬擊光芒特效) */
			/* ========================================== */
			/* 攻擊判定盒設定 */
			.attack {
				position: absolute; /* 變成相對於 .box 定位 */
				width: 150px; /* 可依圖片寬度調整 */
				height: 80px;
				/* background: rgba(241, 196, 15, 0.4); */
				display: none; /* 預設隱藏 */
				top: 400px; /* 調整此數值來對齊你的拳頭高度 */
			}
			.attack2 {
				position: absolute; /* 變成相對於 .box 定位 */
				width: 200px; /* 可依圖片寬度調整 */
				height: 110px;
				/* background: rgba(241, 196, 15, 0.4); */
				display: none; /* 預設隱藏 */
				top: 400px; /* 調整此數值來對齊你的拳頭高度 */
			}

			.instructions {
				position: absolute;
				top: 10px;
				color: #555;
				font-size: 14px;
				text-align: center;
				width: 100%;
			}


			/* ------------------------------------------ */
			/* 玩家 1 (藍方) 預設去背站姿 */
			/* ------------------------------------------ */
			#box1.is-attacking {
				/* ⚠️ 修正重點：將總時間從 2s 修改為 0.8s，並維持定格效果 */
				animation: attack-anim 0.3s steps(1) forwards;
			}
			#box1.is-walking {
				animation: walk-anim 0.5s steps(5) infinite;
			}

			/* ------------------------------------------ */
			/* 玩家 2 (紅方) 預設去背站姿 (鏡像翻轉) */
			/* ------------------------------------------ */
			#box2 {
				background-image: url("src/idle/1.png"); /* 使用相同去背圖 */
				transform: scaleX(-1); /* 讓去背角色面向左邊 */
			}
			#box2.is-attacking {
				/* ⚠️ 修正重點：將這裡從 0.2s 統一修改為與玩家1相同的 0.8s！ */
				animation: attack-anim 0.3s steps(1) forwards;
				transform: scaleX(-1); /* 確保攻擊時維持面向左邊 */
			}
			#box2.is-walking {
				animation: walk-anim 0.5s steps(5) infinite;
				transform: scaleX(-1);
			}

			@keyframes kick-anim {
				0% {
					background-image: url("src/kick/1.png"); /* 0.0s */
				}
				20% {
					background-image: url("src/kick/2.png"); /* 0.08s 蓄力 */
				}
				50% {
					background-image: url("src/kick/5.png"); /* 0.08s 蓄力 */
				}
				100% {
					background-image: url("src/kick/5.png"); /* 0.08s 蓄力 */
				}
			}
			/* ========================================== */
			/* 🎬 CSS Keyframes 連續動畫百分比調配 (總長度 0.8s) */
			/* ========================================== */
			@keyframes attack-anim {
				0% {
					background-image: url("src/attack/1.png"); /* 0.0s */
				}
				10% {
					background-image: url("src/attack/2.png"); /* 0.08s 蓄力 */
				}
				15% {
					background-image: url("src/attack/3.png"); /* 0.12s 出拳中 */
				}
				95% {
					background-image: url("src/attack/4.png"); /* 0.16s 拳頭完全伸直！！！ */
				}
				100% {
					background-image: url("src/attack/4.png"); /* 從 20% 一直停到 100% (定格長達 0.64 秒！) */
				}
			}


			/* Idle 循環動畫定義 */
			@keyframes idle-anim {
				0% {
					background-image: url("src/idle/1.png");
				}
				50% {
					background-image: url("src/idle/2.png");
				} /* 假設你有 2 張 idle 圖 */
				100% {
					background-image: url("src/idle/1.png");
				}
			}
			@keyframes walk-anim {
				0% {
					background-image: url("src/walk/1.png");
				}
				20% {
					background-image: url("src/walk/2.png");
				}
				40% {
					background-image: url("src/walk/3.png");
				}
				60% {
					background-image: url("src/walk/4.png");
				}
				80% {
					background-image: url("src/walk/5.png");
				}
				100% {
					background-image: url("src/walk/2.png");
				}
			}

			/* 走路狀態 (當按下移動鍵時套用) */

			/* 預設狀態：套用 Idle 循環動畫 */
			.box {
				animation: idle-anim 1s steps(1) infinite;
			}

			.box.is-walking {
				animation: walk-anim 0.5s steps(1) infinite;
			}
			/* 攻擊時：暫停 Idle 動畫，改為攻擊動畫 */
			.box.is-attacking {
				animation: attack-anim 0.8s steps(1) forwards;
			}
			.box.is-kicking {
				animation: kick-anim 0.2s steps(1) forwards;
			}
			#box1 .attack {
				left: 250px;
			}

			/* 玩家 2 的攻擊框靠左 (因為翻轉了，所以位置要相反) */
			#box2 .attack {
				right: 250px;
				transform: scaleX(-1);
			}
			/* 被擊中時的圖片樣式 (請替換為你的受傷圖片路徑) */
			.box.is-hit {
				background-image: url("src/hit/1.png") !important;
			}

			/* 如果你希望受傷時有閃爍效果 */
			@keyframes blink {
				0% {
					opacity: 1;
				}
				50% {
					opacity: 0.5;
				}
				100% {
					opacity: 1;
				}
			}
			.box.is-hit {
				animation: blink 0.2s linear infinite !important;
			}
		</style>
	</head>

	<body>
		<div class="game-board">
			<div class="instructions">
				玩家 1: A/D 移動, S 攻擊 | 玩家 2: J/L 移動, K 攻擊
			</div>
			<div id="box1" class="box">
				<div id="hitbox1" class="hitbox"></div>
			</div>
			<div id="box2" class="box">
				<div id="hitbox2" class="hitbox"></div>
			</div>

			<div id="attack1" class="attack"></div>
			<div id="attack2" class="attack"></div>
			<div id="attack_kick1" class="attack2"></div>
			<div id="attack_kick2" class="attack2"></div>
		</div>

		<script>
			// 1. 初始化狀態與位置物件
			const keys = {};
			const p1 = { x: 10, y: 200, isLocked: false, isHit: false };
			const p2 = { x: 800, y: 200, isLocked: false, isHit: false };

			window.addEventListener(
				"keydown",
				(e) => (keys[e.key.toLowerCase()] = true),
			);
			window.addEventListener(
				"keyup",
				(e) => (keys[e.key.toLowerCase()] = false),
			);
			function playSound(file) {
				const audio = new Audio(file);
				audio
					.play()
					.catch((e) => console.log("等待使用者互動後才能播放音效"));
			}
			// 2. 移動系統
			function updateBox(id, map, pos) {
				const box = document.getElementById(id);

				// 如果被鎖定（攻擊中），直接停止所有移動與動畫邏輯
				if (pos.isLocked || pos.isHit) {
					if (box.classList.contains("is-walking")) {
						box.classList.remove("is-walking");
					}
					return;
				}

				// 以下是正常的移動邏輯
				const speed = 2;
				const isMoving = keys[map.left] || keys[map.right];

				if (keys[map.left]) pos.x -= speed;
				if (keys[map.right]) pos.x += speed;

				pos.x = Math.max(0, Math.min(800, pos.x));
				box.style.left = pos.x + "px";

				// 處理移動動畫
				if (isMoving) {
					if (!box.classList.contains("is-walking"))
						box.classList.add("is-walking");
				} else {
					if (box.classList.contains("is-walking"))
						box.classList.remove("is-walking");
				}
			}
			// 修改 spawnHitEffect 接收 targetId 參數
			function spawnHitEffect(x, y, targetId, Pos) {
				// 1. 產生視覺特效 (原本的)
				Pos.isHit = true; // 🔥 設置受擊狀態
				const effect = document.createElement("div");
				effect.className = "hit-effect";
				effect.style.left = x - 50 + "px";
				effect.style.top = y - 50 + "px";
				document.querySelector(".game-board").appendChild(effect);
				setTimeout(() => effect.remove(), 300);

				// 2. 切換圖片狀態
				const target = document.getElementById(targetId);
				target.classList.add("is-hit");

				// 3. 0.3 秒後恢復原狀
				setTimeout(() => {
					target.classList.remove("is-hit");
					Pos.isHit = false; // 🔥 解鎖：受擊時暫停移動與動k畫
				}, 500);
			}
			function spawnCounterEffect(x, y, targetId, Pos) {
				// 1. 產生視覺特效 (原本的)
				Pos.isHit = true; // 🔥 設置受擊狀態
				const effect = document.createElement("div");
				effect.className = "hit-effect";
				effect.style.left = x - 50 + "px";
				effect.style.top = y - 50 + "px";
				document.querySelector(".game-board").appendChild(effect);
				setTimeout(() => effect.remove(), 300);

				// 2. 切換圖片狀態
				const target = document.getElementById(targetId);
				target.classList.add("is-hit");

				// 3. 0.3 秒後恢復原狀
				setTimeout(() => {
					target.classList.remove("is-hit");
					Pos.isHit = false; // 🔥 解鎖：受擊時暫停移動與動k畫
				}, 2000);
			}
			// 3. 攻擊與碰撞系統 (邏輯保持你的優化版) KICK
			function setupAttack_kick(boxId, atkId, key, direction, pos) {
				const box = document.getElementById(boxId);
				const atk = document.getElementById(atkId);
				let attacking = false;

				window.addEventListener("keydown", (e) => {
					if (pos.isHit) return;
					if (e.key.toLowerCase() === key && !attacking) {
						pos.isLocked = true; // 🔥 強制鎖定：此時 updateBox 將無法移動
						attacking = true;
						playSound("src/components/fighter_game/src/kick/1.wav");
						// 0. 記錄原始位置
						const originalX = pos.x;
						const dashDistance = 119; // 想要瞬移的距離

						// 1. 瞬間移動：攻擊開始時直接增加座標
						pos.x +=
							direction === "right"
								? dashDistance
								: -dashDistance;
						box.style.left = pos.x + "px";

						box.classList.add("is-kicking");

						// 2. 動畫結束後瞬間傳送回來
						setTimeout(() => {
							// 瞬間傳送回原位
							pos.x = originalX;
							box.style.left = pos.x + "px";

							atk.style.display = "none";
							box.classList.remove("is-attacking");
							box.classList.remove("is-walking");
							box.classList.remove("is-kicking");

							box.style.animation = "none";
							box.offsetHeight;
							box.style.animation = "";
							attacking = false;
							pos.isLocked = false; // 🔥 解鎖：攻擊結束後恢復移動能力
						}, 499); // 與 CSS 動畫長度對應

						// 攻擊判定盒出現
						setTimeout(() => {
							if (attacking) atk.style.display = "block";
						}, 19);
					}
				});

				// 追蹤器維持不變
				function follow() {
					atk.style.left =
						(direction === "right" ? pos.x + 199 : pos.x) + "px";
					atk.style.top = pos.y + 209 + "px";
					requestAnimationFrame(follow);
				}
				follow();
			}
			// 2. 攻擊與碰撞系統 (邏輯保持你的優化版)
			function setupAttack(boxId, atkId, key, direction, pos) {
				if (pos.isHit) return;

				const box = document.getElementById(boxId);
				const atk = document.getElementById(atkId);
				let attacking = false;

				window.addEventListener("keydown", (e) => {
					if (pos.isHit) return;
					if (e.key.toLowerCase() === key && !attacking) {
						pos.isLocked = true; // 🔥 強制鎖定：此時 updateBox 將無法移動
						attacking = true;
						playSound(
							"src/components/fighter_game/src/attack/1.wav",
						);

						// 0. 記錄原始位置
						const originalX = pos.x;
						const dashDistance = 79; // 想要瞬移的距離

						// 1. 瞬間移動：攻擊開始時直接增加座標
						pos.x +=
							direction === "right"
								? dashDistance
								: -dashDistance;
						box.style.left = pos.x + "px";

						box.classList.add("is-attacking");

						// 2. 動畫結束後瞬間傳送回來
						setTimeout(() => {
							// 瞬間傳送回原位
							pos.x = originalX;
							box.style.left = pos.x + "px";

							atk.style.display = "none";
							box.classList.remove("is-attacking");
							box.classList.remove("is-walking");

							box.style.animation = "none";
							box.offsetHeight;
							box.style.animation = "";
							attacking = false;
							pos.isLocked = false; // 🔥 解鎖：攻擊結束後恢復移動能力
						}, 299); // 與 CSS 動畫長度對應

						// 攻擊判定盒出現
						setTimeout(() => {
							if (attacking) atk.style.display = "block";
						}, 19);
					}
				});

				// 追蹤器維持不變
				function follow() {
					atk.style.left =
						(direction === "right" ? pos.x + 209 : pos.x + 20) +
						"px";
					atk.style.top = pos.y + 199 + "px";
					requestAnimationFrame(follow);
				}
				follow();
			}

			function preventCollision(aId, bId, posA, posB) {
				const a = document.getElementById(aId).querySelector(".hitbox");
				const b = document.getElementById(bId).querySelector(".hitbox");

				function loop() {
					const r1 = a.getBoundingClientRect();
					const r2 = b.getBoundingClientRect();

					if (
						r1.left < r2.right &&
						r1.right > r2.left &&
						r1.top < r2.bottom &&
						r1.bottom > r2.top
					) {
						const dx =
							r1.left + r1.width / 2 - (r2.left + r2.width / 2);
						const overlapX =
							r1.width / 2 + r2.width / 2 - Math.abs(dx);
						const push = overlapX / 2;
						if (dx > 0) {
							posA.x += push;
							posB.x -= push;
						} else {
							posA.x -= push;
							posB.x += push;
						}
					}
					requestAnimationFrame(loop);
				}
				loop();
			}

			function hitCheck(atkId, targetId) {
				const atk = document.getElementById(atkId);
				const target = document.getElementById(targetId);
				if (atk.style.display !== "block") return false;
				const ra = atk.getBoundingClientRect();
				const rt = target.getBoundingClientRect();
				return (
					ra.left < rt.right &&
					ra.right > rt.left &&
					ra.top < rt.bottom &&
					ra.bottom > rt.top
				);
			}

			// 4. 遊戲主迴圈
			function gameLoop() {
				updateBox("box1", { left: "a", right: "d" }, p1);
				updateBox("box2", { left: "j", right: "l" }, p2);
				let player1GetCounter=false;
				let player2GetCounter=false;
				let player1Gethit=false;
				let player2Gethit=false;
				// 檢查傷害 (建議使用之前的冷卻邏輯避免一次判定觸發多次)
				if (
					hitCheck("attack1", "hitbox2") ||
					hitCheck("attack_kick1", "hitbox2")&& player1Gethit===false
				) {
					// 傳入 "box2" 作為受害者 ID
					spawnHitEffect(p2.x + 200, p2.y + 200, "box2", p2);
				}

				if (
					hitCheck("attack2", "hitbox1") ||
					hitCheck("attack_kick2", "hitbox1") && player2Gethit===false
				) {
					// 傳入 "box1" 作为受害者 ID
					spawnHitEffect(p1.x + 200, p1.y + 200, "box1", p1);
				}
				// 檢查傷害 (建議使用之前的冷卻邏輯避免一次判定觸發多次)
				if (
					hitCheck("attack1", "attack2") ||
					hitCheck("attack1", "attack_kick2") ||
					hitCheck("attack_kick1", "attack2") ||
					hitCheck("attack_kick1", "attack_kick2") && player1GetCounter===false
				) {
					// 傳入 "box2" 作為受害者 ID
					player2GetCounter=true;
					spawnCounterEffect(p2.x + 200, p2.y + 200, "box2", p2);
				}

				if (
					hitCheck("attack2", "attack1") ||
					hitCheck("attack2", "attack_kick1") ||
					hitCheck("attack_kick2", "attack1")||
					hitCheck("attack_kick2", "attack_kick1") && player2GetCounter===false
				) {
					player1GetCounter=true;
					// 傳入 "box1" 作为受害者 ID
					spawnCounterEffect(p1.x + 200, p1.y + 200, "box1", p1);
				}


				requestAnimationFrame(gameLoop);
			}

			// 5. 執行初始化
			setupAttack("box1", "attack1", "s", "right", p1);
			setupAttack_kick("box1", "attack_kick1", "w", "right", p1);
			setupAttack("box2", "attack2", "k", "left", p2);
			setupAttack_kick("box2", "attack_kick2", "i", "left", p2);
			preventCollision("box1", "box2", p1, p2);
			gameLoop();
		</script>
	</body>
</html>
