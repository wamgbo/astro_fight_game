<style is:global>
	html,
	body {
		margin: 0;
		height: 100%;
		/* background: #222; 換成深色背景，更容易檢查圖片去背是否完美 */
		display: flex;
		justify-content: center;
		align-items: center;
		font-family: sans-serif;
	}

	.game-container {
		width: 1200px;
		height: 700px;
		overflow: hidden;
		/* border: 8px solid #2ecc71; */
		background:
			linear-gradient(#222 1px, transparent 1px) 0 0 / 20px 20px,
			linear-gradient(90deg, #222 1px, transparent 1px) 0 0 / 20px 20px,
			#111;
		box-shadow:
			inset 0 0 0 2px rgba(255, 255, 255, 0.08),
			0 0 28px rgba(0, 0, 0, 0.45);
		position: relative;
		image-rendering: pixelated;
	}

	.game-container::before {
		content: "";
		position: absolute;
		inset: 10px;
		border: 4px solid rgba(255, 255, 255, 0.12);
		pointer-events: none;
	}

	.game-container::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(
			135deg,
			rgba(255, 255, 255, 0.08) 0%,
			transparent 30%,
			transparent 70%,
			rgba(255, 255, 255, 0.08) 100%
		);
		mix-blend-mode: screen;
		pointer-events: none;
	}

	.game-board {
		position: absolute;
		left: 0;
		top: 0;
		width: 1200px;
		height: 700px;
		background: url(src/bg.png) center/cover no-repeat;
		overflow: hidden;
	}

	/* ========================================== */
	/* 角色基礎樣式 (完美支援去背 PNG) */
	/* ========================================== */
	.box {
		width: 400px;
		height: 1000px;

		position: absolute;

		background-repeat: no-repeat;
		background-position: center;
		background-size: contain;
	}
	.hitbox {
		position: absolute;

		width: 140px;
		height: 320px;

		left: 135px;
		top: 340px;

		/* background: rgba(255, 0, 0, 0.2); */
	}
	.counter-hitbox {
		position: absolute;

		width: 140px;
		height: 320px;

		left: 135px;
		top: 340px;

		/* background: rgba(0, 255, 0, 0.18); */
		/* border: 2px solid rgba(0, 255, 0, 0.8); */
		display: none;
		pointer-events: none;
	}
	.counter-hitbox.active {
		display: block;
	}
	/* ========================================== */
	/* 攻擊判定盒 (可隨時換成去背的斬擊光芒特效) */
	/* ========================================== */
	/* 攻擊判定盒設定 */
	.attack {
		position: absolute; /* 變成相對於 .box 定位 */
		width: 150px; /* 可依圖片寬度調整 */
		height: 80px;
		/* background: rgba(241, 196, 15, 0.4); */
		display: none; /* 預設隱藏 */
		top: 400px; /* 調整此數值來對齊你的拳頭高度 */
	}
	.attack2 {
		position: absolute; /* 變成相對於 .box 定位 */
		width: 200px; /* 可依圖片寬度調整 */
		height: 110px;
		/* background: rgba(241, 196, 15, 0.4); */
		display: none; /* 預設隱藏 */
		top: 400px; /* 調整此數值來對齊你的拳頭高度 */
	}

	.instructions {
		position: absolute;
		top: 10px;
		color: #555;
		font-size: 14px;
		text-align: center;
		width: 100%;
	}

	/* ------------------------------------------ */
	/* 玩家 1 (藍方) 預設去背站姿 */
	/* ------------------------------------------ */
	#box1.is-attacking {
		/* ⚠️ 修正重點：將總時間從 2s 修改為 0.8s，並維持定格效果 */
		animation: attack-anim 0.3s steps(1) forwards;
	}
	#box1.is-walking-left {
		animation: walk-anim 0.5s steps(5) infinite;
		transform: scaleX(-1);
	}
	#box1.is-walking-right {
		animation: walk-anim 0.5s steps(5) infinite;
		transform: scaleX(1);
	}

	/* ------------------------------------------ */
	/* 玩家 2 (紅方) 預設去背站姿 (鏡像翻轉) */
	/* ------------------------------------------ */
	#box2 {
		background-image: url("src/idle/1.png"); /* 使用相同去背圖 */
		transform: scaleX(-1); /* 讓去背角色面向左邊 */
	}
	#box2.is-attacking {
		/* ⚠️ 修正重點：將這裡從 0.2s 統一修改為與玩家1相同的 0.8s！ */
		animation: attack-anim 0.3s steps(1) forwards;
		transform: scaleX(-1); /* 確保攻擊時維持面向左邊 */
	}
	#box2.is-walking-left {
		animation: walk-anim 0.5s steps(5) infinite;
		transform: scaleX(-1);
	}
	#box2.is-walking-right {
		animation: walk-anim 0.5s steps(5) infinite;
		transform: scaleX(1);
	}
	#box1.is-stepping-left,
	#box2.is-stepping-left {
		animation: step-anim 0.28s steps(4) forwards;
		transform: scaleX(-1);
	}
	#box1.is-stepping-right,
	#box2.is-stepping-right {
		animation: step-anim 0.28s steps(4) forwards;
		transform: scaleX(1);
	}

	/* 走路狀態 (當按下移動鍵時套用) */

	/* 預設狀態：套用 Idle 循環動畫 */
	.box {
		animation: idle-anim 1s steps(1) infinite;
	}
	/* 攻擊時：暫停 Idle 動畫，改為攻擊動畫 */
	.box.is-attacking {
		animation: attack-anim 0.8s steps(1) forwards;
	}
	.box.is-kicking {
		animation: kick-anim 0.2s steps(1) forwards;
	}
	#box1 .attack {
		left: 250px;
	}

	/* 玩家 2 的攻擊框靠左 (因為翻轉了，所以位置要相反) */
	#box2 .attack {
		right: 250px;
		transform: scaleX(-1);
	}
	/* 被擊中時的圖片樣式 (請替換為你的受傷圖片路徑) */
	.box.is-hit {
		background-image: url("src/hit/1.png") !important;
	}

	.box.is-hit {
		animation: blink 0.2s linear infinite !important;
	}

	/* 這是你的容器樣式 */
	.heart-bar {
		position: absolute;
		top: 20px;
		height: 70px; /* 務必設定高度！ */
		width: 320px; /* 務必設定高度！ */
		display: flex; /* 讓心心自動排列 */
		align-items: center;
		gap: 5px;
		z-index: 1000;
		border: 2px solid yellow;
		background-color: rgba(
			0,
			0,
			0,
			0.3
		); /* 加一點半透明背景，方便看清範圍 */
	}

	#heart1-bar {
		left: 20px;
	}
	#heart2-bar {
		right: 20px;
		flex-direction: row-reverse;
	}

	/* 這是心臟圖示樣式 */
	.heart-icon {
		width: 100px;
		height: 100px;
		background: url("src/heart/full.png") center/contain no-repeat;
		/* 這裡不需要 position: absolute，因為交給 flex 處理 */
	}
	@keyframes kick-anim {
		0% {
			background-image: url("src/kick/1.png"); /* 0.0s */
		}
		20% {
			background-image: url("src/kick/2.png"); /* 0.08s 蓄力 */
		}
		50% {
			background-image: url("src/kick/5.png"); /* 0.08s 蓄力 */
		}
		100% {
			background-image: url("src/kick/5.png"); /* 0.08s 蓄力 */
		}
	}
	/* ========================================== */
	/* 🎬 CSS Keyframes 連續動畫百分比調配 (總長度 0.8s) */
	/* ========================================== */
	@keyframes attack-anim {
		0% {
			background-image: url("src/attack/1.png"); /* 0.0s */
		}
		10% {
			background-image: url("src/attack/2.png"); /* 0.08s 蓄力 */
		}
		15% {
			background-image: url("src/attack/3.png"); /* 0.12s 出拳中 */
		}
		95% {
			background-image: url("src/attack/4.png"); /* 0.16s 拳頭完全伸直！！！ */
		}
		100% {
			background-image: url("src/attack/4.png"); /* 從 20% 一直停到 100% (定格長達 0.64 秒！) */
		}
	}

	/* Idle 循環動畫定義 */
	@keyframes idle-anim {
		0% {
			background-image: url("src/idle/1.png");
		}
		50% {
			background-image: url("src/idle/2.png");
		} /* 假設你有 2 張 idle 圖 */
		100% {
			background-image: url("src/idle/1.png");
		}
	}
	@keyframes walk-anim {
		0% {
			background-image: url("src/walk/1.png");
		}
		40% {
			background-image: url("src/walk/3.png");
		}
		65% {
			background-image: url("src/walk/2.png");
		}
		80% {
			background-image: url("src/walk/3.png");
		}
		90% {
			background-image: url("src/walk/4.png");
		}
		100% {
			background-image: url("src/walk/5.png");
		}
	}
	@keyframes step-anim {
		0% {
			background-image: url("src/desh/1.png");
		}
		30% {
			background-image: url("src/desh/2.png");
		}
		100% {
			background-image: url("src/desh/3.png");
		}
	}
	/* 如果你希望受傷時有閃爍效果 */
	@keyframes blink {
		0% {
			opacity: 1;
		}
		50% {
			opacity: 0.5;
		}
		100% {
			opacity: 1;
		}
	}
</style>

<body>
	<div class="game-container">
		<div class="game-board">
			<div class="instructions">
				玩家 1: A/D 移動, S 攻擊 | 玩家 2: J/L 移動, K 攻擊
			</div>
			<div id="heart1-bar" class="heart-bar"></div>
			<div id="heart2-bar" class="heart-bar"></div>

			<div id="box1" class="box">
				<div id="hitbox1" class="hitbox"></div>
				<div id="counter1" class="counter-hitbox"></div>
			</div>
			<div id="box2" class="box">
				<div id="hitbox2" class="hitbox"></div>
				<div id="counter2" class="counter-hitbox"></div>
			</div>

			<div id="attack1" class="attack"></div>
			<div id="attack2" class="attack"></div>
			<div id="attack_kick1" class="attack2"></div>
			<div id="attack_kick2" class="attack2"></div>
		</div>
	</div>

	<script>
		// @ts-nocheck
		// 1. 初始化狀態與位置物件
		const keys = {};
		const p1 = {
			x: 10,
			y: 200,
			isLocked: false,
			isHit: false,
			heart: 3,
			heartBar: "heart1-bar",
			isInvincible: false,
			lastAttackTime: 0,
		};
		const p2 = {
			x: 800,
			y: 200,
			isLocked: false,
			isHit: false,
			heart: 3,
			heartBar: "heart2-bar",
			isInvincible: false,
			lastAttackTime: 0,
		};

		function initHearts(heartBarId, count) {
			const container = document.getElementById(heartBarId);
			for (let i = 0; i < count; i++) {
				const heart = document.createElement("div");
				heart.className = "heart-icon"; // 確保掛上正確的類別名稱
				container.appendChild(heart); // 成功把 heart-icon 塞進去
			}
		}
		initHearts(p1.heartBar, p1.heart);
		initHearts(p2.heartBar, p2.heart);
		function subHearts(pos) {
			const container = document.getElementById(pos.heartBar);
			if (pos.heart - 1 <= 0) {
				// 使用 setTimeout 替代未定義的 delay
				container.removeChild(container.lastElementChild);
				setTimeout(() => {
					alert("遊戲結束！");
					window.location.reload();
				}, 500);
				return; // 遊戲結束後不再執行無敵狀態邏輯
			}
			if (container.children.length > 0 && !pos.isInvincible) {
				pos.heart--;
				console.log(`剩餘生命: ${pos.heart}`);
				pos.isInvincible = true;
				container.removeChild(container.lastElementChild);
			}
			setTimeout(() => {
				pos.isInvincible = false;
			}, 500);
		}
		function conunterHearts(pos) {
			const container = document.getElementById(pos.heartBar);
			if (container.children.length < 3 && !pos.isInvincible) {
				const heart = document.createElement("div");
				heart.className = "heart-icon";
				container.appendChild(heart);
				pos.heart++;
				console.log(`反擊成功！回復一顆心，當前生命: ${pos.heart}`);
				pos.isInvincible = true;
			}
			setTimeout(() => {
				pos.isInvincible = false;
			}, 2000);
		}

		window.addEventListener(
			"keydown",
			(e) => (keys[e.key.toLowerCase()] = true),
		);
		window.addEventListener(
			"keyup",
			(e) => (keys[e.key.toLowerCase()] = false),
		);

		function performStep(boxId, pos, direction) {
			const box = document.getElementById(boxId);
			if (!box) return;
			pos.isLocked = true;
			box.classList.remove("is-walking-left", "is-walking-right");
			const stepDistance = direction === "right" ? 150 : -150;
			pos.x = Math.max(0, Math.min(800, pos.x + stepDistance));
			box.style.left = pos.x + "px";
			box.classList.add(
				direction === "right" ? "is-stepping-right" : "is-stepping-left",
			);
			setTimeout(() => {
				box.classList.remove("is-stepping-left", "is-stepping-right");
				pos.isLocked = false;
			}, 280);
		}

		function setupStepMove(boxId, leftKey, rightKey, pos) {
			const tapState = {
				[leftKey]: { count: 0, time: 0 },
				[rightKey]: { count: 0, time: 0 },
			};
			const threshold = 250;

			window.addEventListener("keydown", (e) => {
				if (e.repeat) return;
				const key = e.key.toLowerCase();
				if (pos.isHit || pos.isLocked) return;
				if (key !== leftKey && key !== rightKey) return;

				const now = performance.now();
				const state = tapState[key];
				if (now - state.time < threshold) {
					state.count += 1;
				} else {
					state.count = 1;
				}

				state.time = now;
				if (state.count === 2) {
					performStep(boxId, pos, key === rightKey ? "right" : "left");
					state.count = 0;
				}
			});
		}

		function playSound(file) {
			const audio = new Audio(file);
			audio
				.play()
				.catch((e) => console.log("等待使用者互動後才能播放音效"));
		}
		// 2. 移動系統
		function updateBox(id, map, pos) {
			const box = document.getElementById(id);

			// 如果被鎖定（攻擊中），直接停止所有移動與動畫邏輯
			if (pos.isLocked || pos.isHit) {
				box.classList.remove("is-walking-left", "is-walking-right");
				return;
			}

			// 以下是正常的移動邏輯
			const speed = 2;
			const movingLeft = keys[map.left] && !keys[map.right];
			const movingRight = keys[map.right] && !keys[map.left];

			if (movingLeft) {
				pos.x -= speed;
				box.classList.remove("is-walking-right");
				if (!box.classList.contains("is-walking-left"))
					box.classList.add("is-walking-left");
			} else if (movingRight) {
				pos.x += speed;
				box.classList.remove("is-walking-left");
				if (!box.classList.contains("is-walking-right"))
					box.classList.add("is-walking-right");
			} else {
				box.classList.remove("is-walking-left", "is-walking-right");
			}

			pos.x = Math.max(0, Math.min(800, pos.x));
			box.style.left = pos.x + "px";
		}
		// 修改 spawnHitEffect 接收 targetId 參數
		function spawnHitEffect(x, y, targetId, Pos) {
			// 1. 產生視覺特效 (原本的)
			Pos.isHit = true; // 🔥 設置受擊狀態
			const effect = document.createElement("div");
			effect.className = "hit-effect";
			effect.style.left = x - 50 + "px";
			effect.style.top = y - 50 + "px";
			document.querySelector(".game-board").appendChild(effect);
			setTimeout(() => effect.remove(), 300);

			// 2. 切換圖片狀態
			const target = document.getElementById(targetId);
			target.classList.add("is-hit");

			// 3. 0.3 秒後恢復原狀
			setTimeout(() => {
				target.classList.remove("is-hit");
				Pos.isHit = false; // 🔥 解鎖：受擊時暫停移動與動k畫
			}, 500);
		}
		function spawnCounterEffect(x, y, targetId, Pos) {
			// 1. 產生視覺特效 (原本的)
			Pos.isHit = true; // 🔥 設置受擊狀態
			const effect = document.createElement("div");
			effect.className = "hit-effect";
			effect.style.left = x - 50 + "px";
			effect.style.top = y - 50 + "px";
			document.querySelector(".game-board").appendChild(effect);
			setTimeout(() => effect.remove(), 300);

			// 2. 切換圖片狀態
			const target = document.getElementById(targetId);
			target.classList.add("is-hit");

			// 3. 0.3 秒後恢復原狀
			setTimeout(() => {
				target.classList.remove("is-hit");
				Pos.isHit = false; // 🔥 解鎖：受擊時暫停移動與動k畫
			}, 2000);
		}
		// 3. 攻擊與碰撞系統 (邏輯保持你的優化版) KICK
		function setupAttack_kick(htbox, boxId, atkId, key, direction, pos) {
			const box = document.getElementById(boxId);
			const hbox = document.getElementById(htbox);
			const atk = document.getElementById(atkId);
			const counter = document.getElementById(
				boxId === "box1" ? "counter1" : "counter2",
			);
			let attacking = false;
			let attackWindow = false;

			window.addEventListener("keydown", (e) => {
				if (pos.isHit) return;
				if (e.key.toLowerCase() === key && !attacking) {
					const now = performance.now();
					if (now - pos.lastAttackTime < 600) return;
					pos.lastAttackTime = now;
					attackWindow = false;
					pos.isLocked = true; // 🔥 強制鎖定：此時 updateBox 將無法移動
					attacking = true;
					playSound("src/components/fighter_game/src/kick/1.wav");
					// 0. 記錄原始位置
					const originalX = pos.x;
					const dashDistance = 119; // 想要瞬移的距離

					// 1. 瞬間移動：攻擊開始時直接增加座標
					pos.x +=
						direction === "right" ? dashDistance : -dashDistance;
					box.style.left = pos.x + "px";

					box.classList.add("is-kicking");

					// 2. 動畫結束後瞬間傳送回來
					setTimeout(() => {
						hbox.style.display = "none"; // 確保攻擊判定盒在攻擊結束後隱藏
						counter?.classList.remove("active");
						// 瞬間傳送回原位
						pos.x = originalX;
						box.style.left = pos.x + "px";

						atk.style.display = "none";
						box.classList.remove("is-attacking");
						box.classList.remove("is-walking");
						box.classList.remove("is-kicking");

						box.style.animation = "none";
						box.offsetHeight;
						box.style.animation = "";
						attacking = false;
						pos.isLocked = false; // 🔥 解鎖：攻擊結束後恢復移動能力
						hbox.style.display = "block"; // 確保攻擊判定盒在攻擊結束後隱藏
					}, 499); // 與 CSS 動畫長度對應

					// 攻擊判定盒出現
					setTimeout(() => {
						if (attacking) {
									atk.style.display = "block";
									counter?.classList.add("active");
									attackWindow = true;
								}
					}, 200);
					setTimeout(() => {
						if (attacking) {
							counter?.classList.remove("active");
							attackWindow = false;
						}
					}, 210);
				}
			});

			// 追蹤器維持不變
			function follow() {
				atk.style.left =
					(direction === "right" ? pos.x + 199 : pos.x) + "px";
				atk.style.top = pos.y + 209 + "px";
				requestAnimationFrame(follow);
			}
			follow();
		}
		// 2. 攻擊與碰撞系統 (邏輯保持你的優化版)
		function setupAttack(boxId, atkId, key, direction, pos) {
			if (pos.isHit) return;

			const box = document.getElementById(boxId);
			const atk = document.getElementById(atkId);
			const counter = document.getElementById(
				boxId === "box1" ? "counter1" : "counter2",
			);

			let startTime = 0;

			window.addEventListener("keydown", (e) => {
				if (pos.isHit || pos.isLocked) return;
				if (e.key.toLowerCase() === key && !pos.isLocked) {
					const now = performance.now();
					if (now - pos.lastAttackTime < 600) return;
					pos.lastAttackTime = now;
					pos.isLocked = true;
					startTime = performance.now(); // 🔥 這裡必須更新 startTime

					// ... (原本的音效與瞬間移動邏輯保持不變)
					pos.isLocked = true;
					playSound("src/components/fighter_game/src/attack/1.wav");

					const originalX = pos.x;
					pos.x += direction === "right" ? 79 : -79;
					box.style.left = pos.x + "px";
					box.classList.add("is-attacking");

					setTimeout(() => {
						pos.x = originalX;
						box.style.left = pos.x + "px";
						atk.style.display = "none";
						counter?.classList.remove("active");
						box.classList.remove("is-attacking");
						pos.isLocked = false;
					}, 400);
				}
			});

			function follow(now) {
				if (pos.isLocked) {
					const elapsed = now - startTime;

					// 1. 控制攻擊盒的顯示與偏移
					let kickExtension = 0;

					if (elapsed < 100) {
						atk.style.display = "none"; // 蓄力階段不顯示
						counter?.classList.remove("active");
					} else if (elapsed >= 100 && elapsed < 280) {
						atk.style.display = "block"; // 踢擊階段顯示
						counter?.classList.add("active");
						kickExtension =
							pos.heartBar === "heart1-bar" ? 30 : -200; // 根據玩家不同增加額外距離
					} else {
						atk.style.display = "none"; // 收回階段隱藏
						counter?.classList.remove("active");
					}

					// 2. 計算 X 軸位置
					const baseOffset = direction === "right" ? 209 : 20;
					const finalX =
						direction === "right"
							? pos.x + baseOffset + kickExtension
							: pos.x - 180 - kickExtension;

					atk.style.left = finalX + "px";
					atk.style.top = pos.y + 199 + "px";
				} else {
					// 非攻擊狀態強制隱藏
					atk.style.display = "none";
				}

				requestAnimationFrame(follow);
			}
			requestAnimationFrame(follow);
		}

		function preventCollision(aId, bId, posA, posB) {
			const a = document.getElementById(aId).querySelector(".hitbox");
			const b = document.getElementById(bId).querySelector(".hitbox");

			function loop() {
				const r1 = a.getBoundingClientRect();
				const r2 = b.getBoundingClientRect();

				if (
					r1.left < r2.right &&
					r1.right > r2.left &&
					r1.top < r2.bottom &&
					r1.bottom > r2.top
				) {
					const dx =
						r1.left + r1.width / 2 - (r2.left + r2.width / 2);
					const overlapX = r1.width / 2 + r2.width / 2 - Math.abs(dx);
					const push = overlapX / 2;
					if (dx > 0) {
						posA.x += push;
						posB.x -= push;
					} else {
						posA.x -= push;
						posB.x += push;
					}
				}
				requestAnimationFrame(loop);
			}
			loop();
		}

		function hitCheck(atkId, targetId) {
			const atk = document.getElementById(atkId);
			const target = document.getElementById(targetId);
			if (atk.style.display !== "block") return false;
			const ra = atk.getBoundingClientRect();
			const rt = target.getBoundingClientRect();
			return (
				ra.left < rt.right &&
				ra.right > rt.left &&
				ra.top < rt.bottom &&
				ra.bottom > rt.top
			);
		}

		// 4. 遊戲主迴圈
		// 攻擊冷卻追蹤 (防止同一攻擊在多幀內重複觸發傷害)
		const attackCooldown = {
			attack1: 0,
			attack_kick1: 0,
			attack2: 0,
			attack_kick2: 0,
		};
		const COOLDOWN_MS = 50; // 50ms 冷卻時間

		function gameLoop() {
			updateBox("box1", { left: "a", right: "d" }, p1);
			updateBox("box2", { left: "j", right: "l" }, p2);
			const now = performance.now();

			// ========== 玩家2 受傷檢查 ==========
			if (p2.isInvincible === false) {
				// 優先度 1: 懲罰反擊 (擊中 counter2)
				if (
					(hitCheck("attack1", "counter2") &&
						now - attackCooldown.attack1 > COOLDOWN_MS) ||
					(hitCheck("attack_kick1", "counter2") &&
						now - attackCooldown.attack_kick1 > COOLDOWN_MS)
				) {
					console.log("玩家1觸發懲罰反擊！玩家1扣血！");
					spawnCounterEffect(p1.x + 200, p1.y + 200, "box1", p1);
					subHearts(p1); // 玩家1受罰
					attackCooldown.attack1 = now;
					attackCooldown.attack_kick1 = now;
				}
				// 優先度 2: 相互攻擊 (攻擊互相碰撞)
				else if (
					(hitCheck("attack1", "attack2") &&
						now - attackCooldown.attack1 > COOLDOWN_MS) ||
					(hitCheck("attack1", "attack_kick2") &&
						now - attackCooldown.attack1 > COOLDOWN_MS) ||
					(hitCheck("attack_kick1", "attack2") &&
						now - attackCooldown.attack_kick1 > COOLDOWN_MS) ||
					(hitCheck("attack_kick1", "attack_kick2") &&
						now - attackCooldown.attack_kick1 > COOLDOWN_MS &&
						p2.isLocked === true)
				) {
					console.log("攻擊相互碰撞！雙方都扣血！");
					spawnCounterEffect(p2.x + 200, p2.y + 200, "box2", p2);
					conunterHearts(p1); // 玩家1獲得加成
					subHearts(p2); // 玩家2扣血
					attackCooldown.attack1 = now;
					attackCooldown.attack_kick1 = now;
				}
				// 優先度 3: 正常命中 (擊中 hitbox2)
				else if (
					(hitCheck("attack1", "hitbox2") &&
						now - attackCooldown.attack1 > COOLDOWN_MS) ||
					(hitCheck("attack_kick1", "hitbox2") &&
						now - attackCooldown.attack_kick1 > COOLDOWN_MS)
				) {
					console.log("玩家1攻擊命中玩家2！");
					subHearts(p2);
					spawnHitEffect(p2.x + 200, p2.y + 200, "box2", p2);
					attackCooldown.attack1 = now;
					attackCooldown.attack_kick1 = now;
				}
			}

			// ========== 玩家1 受傷檢查 ==========
			if (p1.isInvincible === false) {
				// 優先度 1: 懲罰反擊 (擊中 counter1)
				if (
					(hitCheck("attack2", "counter1") &&
						now - attackCooldown.attack2 > COOLDOWN_MS) ||
					(hitCheck("attack_kick2", "counter1") &&
						now - attackCooldown.attack_kick2 > COOLDOWN_MS)
				) {
					console.log("玩家2觸發懲罰反擊！玩家2扣血！");
					spawnCounterEffect(p2.x + 200, p2.y + 200, "box2", p2);
					subHearts(p2); // 玩家2受罰
					attackCooldown.attack2 = now;
					attackCooldown.attack_kick2 = now;
				}
				// 優先度 2: 相互攻擊 (攻擊互相碰撞)
				else if (
					(hitCheck("attack2", "attack1") &&
						now - attackCooldown.attack2 > COOLDOWN_MS) ||
					(hitCheck("attack2", "attack_kick1") &&
						now - attackCooldown.attack2 > COOLDOWN_MS) ||
					(hitCheck("attack_kick2", "attack1") &&
						now - attackCooldown.attack_kick2 > COOLDOWN_MS) ||
					(hitCheck("attack_kick2", "attack_kick1") &&
						now - attackCooldown.attack_kick2 > COOLDOWN_MS &&
						p1.isLocked === true)
				) {
					console.log("攻擊相互碰撞！雙方都扣血！");
					spawnCounterEffect(p1.x + 200, p1.y + 200, "box1", p1);
					conunterHearts(p2); // 玩家2獲得加成
					subHearts(p1); // 玩家1扣血
					attackCooldown.attack2 = now;
					attackCooldown.attack_kick2 = now;
				}
				// 優先度 3: 正常命中 (擊中 hitbox1)
				else if (
					(hitCheck("attack2", "hitbox1") &&
						now - attackCooldown.attack2 > COOLDOWN_MS) ||
					(hitCheck("attack_kick2", "hitbox1") &&
						now - attackCooldown.attack_kick2 > COOLDOWN_MS)
				) {
					console.log("玩家2攻擊命中玩家1！");
					subHearts(p1);
					spawnHitEffect(p1.x + 200, p1.y + 200, "box1", p1);
					attackCooldown.attack2 = now;
					attackCooldown.attack_kick2 = now;
				}
			}
			// if (
			// 	attack1.style.display === "none" ||
			// 	attack_kick1.style.display === "none"
			// ) {
			// 	player1Gethit = false;
			// }
			requestAnimationFrame(gameLoop);
		}

		// 5. 執行初始化
		setupAttack("box1", "attack1", "s", "right", p1);
		setupAttack_kick("hitbox1", "box1", "attack_kick1", "w", "right", p1);
		setupStepMove("box1", "a", "d", p1);
		setupStepMove("box2", "j", "l", p2);
		setupAttack("box2", "attack2", "k", "left", p2);
		setupAttack_kick("hitbox2", "box2", "attack_kick2", "i", "left", p2);
		preventCollision("box1", "box2", p1, p2);
		gameLoop();
	</script>
</body>
