<style is:global>
	html,
	body {
		margin: 0;
		height: 100%;
		/* background: #222; 換成深色背景，更容易檢查圖片去背是否完美 */
		display: flex;
		justify-content: center;
		align-items: center;
		font-family: sans-serif;
	}

	.game-container {
		width: 1200px;
		height: 700px;
		overflow: hidden;
		/* border: 8px solid #2ecc71; */
		background:
			linear-gradient(#222 1px, transparent 1px) 0 0 / 20px 20px,
			linear-gradient(90deg, #222 1px, transparent 1px) 0 0 / 20px 20px,
			#111;
		box-shadow:
			inset 0 0 0 2px rgba(255, 255, 255, 0.08),
			0 0 28px rgba(0, 0, 0, 0.45);
		position: relative;
		image-rendering: pixelated;
	}

	.game-container::before {
		content: "";
		position: absolute;
		inset: 10px;
		border: 4px solid rgba(255, 255, 255, 0.12);
		pointer-events: none;
	}

	.game-container::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(
			135deg,
			rgba(255, 255, 255, 0.08) 0%,
			transparent 30%,
			transparent 70%,
			rgba(255, 255, 255, 0.08) 100%
		);
		mix-blend-mode: screen;
		pointer-events: none;
	}

	.game-board {
		position: absolute;
		left: 0;
		top: 0;
		width: 1200px;
		height: 700px;
		background: url(src/bg.png) center/cover no-repeat;
		overflow: hidden;
	}

	/* ========================================== */
	/* 角色基礎樣式 (完美支援去背 PNG) */
	/* ========================================== */
	.box {
		width: 400px;
		height: 1000px;

		position: absolute;

		background-repeat: no-repeat;
		background-position: center;
		background-size: contain;
	}
	.hitbox {
		position: absolute;

		width: 140px;
		height: 320px;

		left: 135px;
		top: 340px;

		/* background: rgba(255, 0, 0, 0.2); */
	}
	.counter-hitbox {
		position: absolute;

		width: 140px;
		height: 320px;

		left: 135px;
		top: 340px;

		/* background: rgba(0, 255, 0, 0.18); */
		/* border: 2px solid rgba(0, 255, 0, 0.8); */
		display: none;
		pointer-events: none;
	}
	.counter-hitbox.active {
		display: block;
	}
	/* ========================================== */
	/* 攻擊判定盒 (可隨時換成去背的斬擊光芒特效) */
	/* ========================================== */
	/* 攻擊判定盒設定 */
	.attack {
		position: absolute; /* 變成相對於 .box 定位 */
		width: 150px; /* 可依圖片寬度調整 */
		height: 80px;
		/* background: rgba(241, 196, 15, 0.4); */
		display: none; /* 預設隱藏 */
		top: 400px; /* 調整此數值來對齊你的拳頭高度 */
	}
	.attack2 {
		position: absolute; /* 變成相對於 .box 定位 */
		width: 200px; /* 可依圖片寬度調整 */
		height: 110px;
		/* background: rgba(241, 196, 15, 0.4); */
		display: none; /* 預設隱藏 */
		top: 400px; /* 調整此數值來對齊你的拳頭高度 */
	}

	.instructions {
		position: absolute;
		top: 10px;
		color: #555;
		font-size: 14px;
		text-align: center;
		width: 100%;
	}

	/* ------------------------------------------ */
	/* 玩家 1 (藍方) 預設去背站姿 */
	/* ------------------------------------------ */
	#box1.is-attacking {
		/* ⚠️ 修正重點：將總時間從 2s 修改為 0.8s，並維持定格效果 */
		animation: attack-anim 0.3s steps(1) forwards;
	}
	#box1.is-walking-left {
		animation: walk-anim 0.5s steps(5) infinite;
		transform: scaleX(-1);
	}
	#box1.is-walking-right {
		animation: walk-anim 0.5s steps(5) infinite;
		transform: scaleX(1);
	}

	/* ------------------------------------------ */
	/* 玩家 2 (紅方) 預設去背站姿 (鏡像翻轉) */
	/* ------------------------------------------ */
	#box2 {
		background-image: url("src/idle/1.png"); /* 使用相同去背圖 */
		transform: scaleX(-1); /* 讓去背角色面向左邊 */
	}
	#box2.is-attacking {
		/* ⚠️ 修正重點：將這裡從 0.2s 統一修改為與玩家1相同的 0.8s！ */
		animation: attack-anim 0.3s steps(1) forwards;
		transform: scaleX(-1); /* 確保攻擊時維持面向左邊 */
	}
	#box2.is-walking-left {
		animation: walk-anim 0.5s steps(5) infinite;
		transform: scaleX(-1);
	}
	#box2.is-walking-right {
		animation: walk-anim 0.5s steps(5) infinite;
		transform: scaleX(1);
	}
	#box1.is-stepping-left,
	#box2.is-stepping-left {
		animation: step-anim 0.28s steps(4) forwards;
		transform: scaleX(-1);
	}
	#box1.is-stepping-right,
	#box2.is-stepping-right {
		animation: step-anim 0.28s steps(4) forwards;
		transform: scaleX(1);
	}

	/* 走路狀態 (當按下移動鍵時套用) */

	/* 預設狀態：套用 Idle 循環動畫 */
	.box {
		animation: idle-anim 1s steps(1) infinite;
	}
	/* 攻擊時：暫停 Idle 動畫，改為攻擊動畫 */
	.box.is-attacking {
		animation: attack-anim 0.8s steps(1) forwards;
	}
	.box.is-kicking {
		animation: kick-anim 0.2s steps(1) forwards;
	}
	#box1 .attack {
		left: 250px;
	}

	/* 玩家 2 的攻擊框靠左 (因為翻轉了，所以位置要相反) */
	#box2 .attack {
		right: 250px;
		transform: scaleX(-1);
	}
	/* 被擊中時的圖片樣式 (請替換為你的受傷圖片路徑) */
	.box.is-hit {
		background-image: url("src/hit/1.png") !important;
	}

	.box.is-hit {
		animation: blink 0.2s linear infinite !important;
	}

	/* 這是你的容器樣式 */
	.heart-bar {
		position: absolute;
		top: 20px;
		height: 70px; /* 務必設定高度！ */
		width: 320px; /* 務必設定高度！ */
		display: flex; /* 讓心心自動排列 */
		align-items: center;
		gap: 5px;
		z-index: 1000;
		border: 2px solid yellow;
		background-color: rgba(
			0,
			0,
			0,
			0.3
		); /* 加一點半透明背景，方便看清範圍 */
	}

	#heart1-bar {
		left: 20px;
	}
	#heart2-bar {
		right: 20px;
		flex-direction: row-reverse;
	}

	/* 這是心臟圖示樣式 */
	.heart-icon {
		width: 100px;
		height: 100px;
		background: url("src/heart/full.png") center/contain no-repeat;
		/* 這裡不需要 position: absolute，因為交給 flex 處理 */
	}
	@keyframes kick-anim {
		0% {
			background-image: url("src/kick/1.png"); /* 0.0s */
		}
		20% {
			background-image: url("src/kick/2.png"); /* 0.08s 蓄力 */
		}
		50% {
			background-image: url("src/kick/5.png"); /* 0.08s 蓄力 */
		}
		100% {
			background-image: url("src/kick/5.png"); /* 0.08s 蓄力 */
		}
	}
	/* ========================================== */
	/* 🎬 CSS Keyframes 連續動畫百分比調配 (總長度 0.8s) */
	/* ========================================== */
	@keyframes attack-anim {
		0% {
			background-image: url("src/attack/1.png"); /* 0.0s */
		}
		10% {
			background-image: url("src/attack/2.png"); /* 0.08s 蓄力 */
		}
		15% {
			background-image: url("src/attack/3.png"); /* 0.12s 出拳中 */
		}
		95% {
			background-image: url("src/attack/4.png"); /* 0.16s 拳頭完全伸直！！！ */
		}
		100% {
			background-image: url("src/attack/4.png"); /* 從 20% 一直停到 100% (定格長達 0.64 秒！) */
		}
	}

	/* Idle 循環動畫定義 */
	@keyframes idle-anim {
		0% {
			background-image: url("src/idle/1.png");
		}
		50% {
			background-image: url("src/idle/2.png");
		} /* 假設你有 2 張 idle 圖 */
		100% {
			background-image: url("src/idle/1.png");
		}
	}
	@keyframes walk-anim {
		0% {
			background-image: url("src/walk/1.png");
		}
		40% {
			background-image: url("src/walk/3.png");
		}
		65% {
			background-image: url("src/walk/2.png");
		}
		80% {
			background-image: url("src/walk/3.png");
		}
		90% {
			background-image: url("src/walk/4.png");
		}
		100% {
			background-image: url("src/walk/5.png");
		}
	}
	@keyframes step-anim {
		0% {
			background-image: url("src/desh/1.png");
		}
		30% {
			background-image: url("src/desh/2.png");
		}
		100% {
			background-image: url("src/desh/3.png");
		}
	}
	/* 如果你希望受傷時有閃爍效果 */
	@keyframes blink {
		0% {
			opacity: 1;
		}
		50% {
			opacity: 0.5;
		}
		100% {
			opacity: 1;
		}
	}
</style>

<body>
	<div class="game-container">
		<button
			id="debugBtn"
			style="
  position:absolute; top:670px; right:20px; z-index:2000;
  background:#1a1a1a; color:#0ff; border:1px solid #0ff;
  font-family:'Courier New',monospace; font-size:12px;
  padding:6px 14px; cursor:pointer; letter-spacing:2px;
"
			>[ DEBUG: OFF ]</button
		>
		<div class="game-board">
			<canvas
				id="gameOverCanvas"
				width="1200"
				height="700"
				style="display:none;position:absolute;top:0;left:0;z-index:9999;image-rendering:pixelated;"
			></canvas>

			<div class="instructions">
				玩家 1: A/D 移動, S 攻擊 | 玩家 2: J/L 移動, K 攻擊
			</div>
			<div id="heart1-bar" class="heart-bar"></div>
			<div id="heart2-bar" class="heart-bar"></div>

			<div id="box1" class="box">
				<div id="hitbox1" class="hitbox"></div>
				<div id="counter1" class="counter-hitbox"></div>
			</div>
			<div id="box2" class="box">
				<div id="hitbox2" class="hitbox"></div>
				<div id="counter2" class="counter-hitbox"></div>
			</div>

			<div id="attack1" class="attack"></div>
			<div id="attack2" class="attack"></div>
			<div id="attack_kick1" class="attack2"></div>
			<div id="attack_kick2" class="attack2"></div>
			<canvas id="gameCanvas" width="800" height="450"></canvas>
		</div>
	</div>

	<script>
		function showGameOver() {
			const canvas = document.getElementById("gameOverCanvas");
			canvas.style.display = "block";
			const ctx = canvas.getContext("2d");
			const W = 1200,
				H = 700;
			let t = 0,
				hovBtn = false;
			const BX = W / 2 - 200,
				BY = 500,
				BW = 400,
				BH = 90;

			function px(x, y, w, h, c) {
				ctx.fillStyle = c;
				ctx.fillRect(x, y, w, h);
			}

			function drawBg() {
				px(0, 0, W, H, "#0a0006");
				for (let x = 0; x < W; x += 40)
					for (let y = 0; y < H; y += 40) {
						px(x, y, 1, 40, "rgba(180,0,0,0.06)");
						px(x, y, 40, 1, "rgba(180,0,0,0.06)");
					}
			}

			function drawSlashLines() {
				const alpha = 0.06 + Math.abs(Math.sin(t * 0.04)) * 0.08;
				ctx.strokeStyle = `rgba(255,30,0,${alpha})`;
				ctx.lineWidth = 3;
				for (let i = 0; i < 6; i++) {
					const ox = Math.sin(t * 0.03 + i) * 15;
					ctx.beginPath();
					ctx.moveTo(ox + i * 210, 0);
					ctx.lineTo(ox + i * 210 + 80, H);
					ctx.stroke();
				}
			}

			function drawFloorLine() {
				const fy = H - 110;
				px(0, fy, W, 3, "#8b0000");
				px(0, fy + 3, W, 2, "#ff3300");
				for (let x = 0; x < W; x += 60)
					px(x, fy + 6, 30, 1, "rgba(255,80,0,0.3)");
			}

			function drawSilhouette(x, flip) {
				ctx.save();
				if (flip) {
					ctx.translate(x * 2, 0);
					ctx.scale(-1, 1);
				}
				const b = x,
					s = 2;
				px(b + 56, 130, 44, 44, "#1a0010");
				px(b + 48, 122, 60, 16, "#1a0010");
				px(b + 52, 174, 52, 110, "#1a0010");
				px(b + 28, 190, 30, 80, "#1a0010");
				px(b + 104, 188, 28, 76, "#1a0010");
				px(b + 56, 284, 28, 110, "#1a0010");
				px(b + 84, 284, 28, 110, "#1a0010");
				px(b + 40, 392, 36, 18, "#1a0010");
				px(b + 84, 392, 40, 18, "#1a0010");
				ctx.restore();
			}

			function drawKO() {
				const pulse = Math.sin(t * 0.07) * 5;
				ctx.textAlign = "center";
				const layers = [
					{ c: "#3b0000", ox: 10, oy: 10 },
					{ c: "#7a0000", ox: 5, oy: 5 },
					{ c: "#cc0000", ox: 2, oy: 2 },
					{ c: "#ff2200", ox: 0, oy: 0 },
					{ c: "#ff7755", ox: -2, oy: -2 },
				];
				ctx.font = `900 ${200 + pulse}px "Arial Black","Arial",sans-serif`;
				layers.forEach((l) => {
					ctx.fillStyle = l.c;
					ctx.fillText("K.O.", W / 2 + l.ox, 280 + l.oy + pulse / 2);
				});

				ctx.font = `900 58px "Arial Black","Arial",sans-serif`;
				const gp = Math.sin(t * 0.1) * 3;
				[
					{ c: "#2a0000", ox: 5, oy: 5 },
					{ c: "#880000", ox: 2, oy: 2 },
					{ c: "#ff4400", ox: 0, oy: 0 },
				].forEach((l) => {
					ctx.fillStyle = l.c;
					ctx.fillText("GAME  OVER", W / 2 + l.ox, 340 + l.oy + gp);
				});
			}

			function drawHitSparks() {
				[
					[W / 2 - 80, 150],
					[W / 2 + 100, 130],
					[W / 2 - 20, 180],
					[W / 2 + 60, 165],
				].forEach(([sx, sy], i) => {
					if (Math.sin(t * 0.14 + i * 1.3) > 0.4) {
						const s = 5 + i * 2;
						px(sx - s, sy - s, s * 2, s * 2, "#ffcc00");
						px(sx - 2, sy - s * 2, 4, s * 4, "#ff6600");
						px(sx - s * 2, sy - 2, s * 4, 4, "#ff6600");
					}
				});
			}

			function drawButton() {
				const flash = Math.sin(t * 0.1) > 0.3;
				if (hovBtn) {
					px(BX - 4, BY - 4, BW + 8, BH + 8, "#ff2200");
					px(BX, BY, BW, BH, "#cc1100");
				} else {
					px(BX - 3, BY - 3, BW + 6, BH + 6, "#550000");
					px(BX, BY, BW, BH, "#1a0008");
					if (flash) {
						ctx.strokeStyle = "#ff2200";
						ctx.lineWidth = 3;
						ctx.strokeRect(BX + 2, BY + 2, BW - 4, BH - 4);
					}
				}
				px(BX + 6, BY + 6, BW - 12, 3, hovBtn ? "#ff6644" : "#440000");
				px(
					BX + 6,
					BY + BH - 9,
					BW - 12,
					3,
					hovBtn ? "#660000" : "#220000",
				);
				ctx.font = `900 32px "Arial Black","Arial",sans-serif`;
				ctx.textAlign = "center";
				ctx.fillStyle = hovBtn ? "#ffffff" : "#ff3300";
				ctx.fillText("[ CONTINUE? ]", W / 2, BY + BH * 0.68);
			}

			function drawTimer() {
				const count = Math.max(0, 9 - Math.floor(t / 30));
				ctx.font = `900 24px "Courier New",monospace`;
				ctx.textAlign = "left";
				ctx.fillStyle = "rgba(255,60,0,0.7)";
				ctx.fillText(`CONTINUE: ${count}`, 30, H - 30);
				if (count === 0) {
					setTimeout(() => window.location.reload(), 800);
				}
			}

			function drawCRT() {
				ctx.fillStyle = "rgba(0,0,0,0.12)";
				for (let y = 0; y < H; y += 4) ctx.fillRect(0, y, W, 2);
				px(0, 0, 8, H, "rgba(0,0,0,0.3)");
				px(W - 8, 0, 8, H, "rgba(0,0,0,0.3)");
				px(0, 0, W, 8, "rgba(0,0,0,0.3)");
				px(0, H - 8, W, 8, "rgba(0,0,0,0.3)");
			}

			function render() {
				ctx.clearRect(0, 0, W, H);
				drawBg();
				drawSlashLines();
				drawFloorLine();
				drawSilhouette(220, false);
				drawSilhouette(700, true);
				drawHitSparks();
				drawKO();
				drawButton();
				drawTimer();
				drawCRT();
				t++;
				requestAnimationFrame(render);
			}

			canvas.addEventListener("mousemove", (e) => {
				const r = canvas.getBoundingClientRect();
				const mx = (e.clientX - r.left) * (W / r.width);
				const my = (e.clientY - r.top) * (H / r.height);
				hovBtn = mx >= BX && mx <= BX + BW && my >= BY && my <= BY + BH;
			});
			canvas.addEventListener("mouseleave", () => (hovBtn = false));
			canvas.addEventListener("click", (e) => {
				const r = canvas.getBoundingClientRect();
				const mx = (e.clientX - r.left) * (W / r.width);
				const my = (e.clientY - r.top) * (H / r.height);
				if (mx >= BX && mx <= BX + BW && my >= BY && my <= BY + BH)
					window.location.reload();
			});

			render();
		}
		// @ts-nocheck
		// 1. 初始化狀態與位置物件
		const keys = {};
		const p1 = {
			x: 10,
			y: 200,
			isLocked: false,
			isHit: false,
			heart: 3,
			heartBar: "heart1-bar",
			isInvincible: false,
			lastAttackTime: 0,
		};
		const p2 = {
			x: 800,
			y: 200,
			isLocked: false,
			isHit: false,
			heart: 3,
			heartBar: "heart2-bar",
			isInvincible: false,
			lastAttackTime: 0,
		};

		function initHearts(heartBarId, count) {
			const container = document.getElementById(heartBarId);
			for (let i = 0; i < count; i++) {
				const heart = document.createElement("div");
				heart.className = "heart-icon"; // 確保掛上正確的類別名稱
				container.appendChild(heart); // 成功把 heart-icon 塞進去
			}
		}
		initHearts(p1.heartBar, p1.heart);
		initHearts(p2.heartBar, p2.heart);
		function subHearts(pos) {
			const container = document.getElementById(pos.heartBar);
			if (pos.heart - 1 <= 0) {
				// 使用 setTimeout 替代未定義的 delay
				container.removeChild(container.lastElementChild);
				setTimeout(() => {
					// alert("遊戲結束！");
					// window.location.reload();
					showGameOver();
				}, 500);
				return; // 遊戲結束後不再執行無敵狀態邏輯
			}
			if (container.children.length > 0 && !pos.isInvincible) {
				pos.heart--;
				console.log(`剩餘生命: ${pos.heart}`);
				pos.isInvincible = true;
				container.removeChild(container.lastElementChild);
			}
			setTimeout(() => {
				pos.isInvincible = false;
			}, 500);
		}
		function conunterHearts(pos) {
			const container = document.getElementById(pos.heartBar);
			if (container.children.length < 3 && !pos.isInvincible) {
				const heart = document.createElement("div");
				heart.className = "heart-icon";
				container.appendChild(heart);
				pos.heart++;
				console.log(`反擊成功！回復一顆心，當前生命: ${pos.heart}`);
				pos.isInvincible = true;
			}
			setTimeout(() => {
				pos.isInvincible = false;
			}, 2000);
		}

		window.addEventListener(
			"keydown",
			(e) => (keys[e.key.toLowerCase()] = true),
		);
		window.addEventListener(
			"keyup",
			(e) => (keys[e.key.toLowerCase()] = false),
		);

		function performStep(boxId, pos, direction) {
			const box = document.getElementById(boxId);
			if (!box) return;
			pos.isLocked = true;
			box.classList.remove("is-walking-left", "is-walking-right");
			const stepDistance = direction === "right" ? 150 : -150;
			pos.x = Math.max(0, Math.min(800, pos.x + stepDistance));
			box.style.left = pos.x + "px";
			box.classList.add(
				direction === "right"
					? "is-stepping-right"
					: "is-stepping-left",
			);
			setTimeout(() => {
				box.classList.remove("is-stepping-left", "is-stepping-right");
				pos.isLocked = false;
			}, 280);
		}

		function setupStepMove(boxId, leftKey, rightKey, pos) {
			const tapState = {
				[leftKey]: { count: 0, time: 0 },
				[rightKey]: { count: 0, time: 0 },
			};
			const threshold = 250;

			window.addEventListener("keydown", (e) => {
				if (e.repeat) return;
				const key = e.key.toLowerCase();
				if (pos.isHit || pos.isLocked) return;
				if (key !== leftKey && key !== rightKey) return;

				const now = performance.now();
				const state = tapState[key];
				if (now - state.time < threshold) {
					state.count += 1;
				} else {
					state.count = 1;
				}

				state.time = now;
				if (state.count === 2) {
					performStep(
						boxId,
						pos,
						key === rightKey ? "right" : "left",
					);
					state.count = 0;
				}
			});
		}

		function playSound(file) {
			const audio = new Audio(file);
			audio
				.play()
				.catch((e) => console.log("等待使用者互動後才能播放音效"));
		}
		// 2. 移動系統
		// function updateBox(id, map, pos) {
		// 	const box = document.getElementById(id);

		// 	// 如果被鎖定（攻擊中），直接停止所有移動與動畫邏輯
