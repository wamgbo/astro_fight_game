		function updateBox(id, map, pos) {
			const box = document.getElementById(id);

			if (pos.isLocked || pos.isHit) {
				// 只有當原本不是 idle 時才觸發 DOM 操作
				if (pos.animState !== "idle") {
					box.classList.remove("is-walking-left", "is-walking-right");
					pos.animState = "idle";
				}
				return;
			}

			const speed = 2;
			const movingLeft = keys[map.left] && !keys[map.right];
			const movingRight = keys[map.right] && !keys[map.left];

			let nextAnim = "idle";

			if (movingLeft) {
				pos.x -= speed;
				nextAnim = "left";
			} else if (movingRight) {
				pos.x += speed;
				nextAnim = "right";
			}

			// 🌟 核心優化：只有當「這幀的動作」跟「上一幀」不一樣時，才去改 DOM Class！
			if (pos.animState !== nextAnim) {
				pos.animState = nextAnim; // 更新記憶體狀態

				// 集中一次性處理 Class，避免瀏覽器重複計算排版
				box.classList.toggle("is-walking-left", nextAnim === "left");
				box.classList.toggle("is-walking-right", nextAnim === "right");
			}

			pos.x = Math.max(0, Math.min(800, pos.x));
			box.style.left = pos.x + "px";
		}
		// 修改 spawnHitEffect 接收 targetId 參數
		function spawnHitEffect(x, y, targetId, Pos) {
			// 1. 產生視覺特效 (原本的)
			Pos.isHit = true; // 🔥 設置受擊狀態
			const effect = document.createElement("div");
			effect.className = "hit-effect";
			effect.style.left = x - 50 + "px";
			effect.style.top = y - 50 + "px";
			document.querySelector(".game-board").appendChild(effect);
			setTimeout(() => effect.remove(), 300);

			// 2. 切換圖片狀態
			const target = document.getElementById(targetId);
			target.classList.add("is-hit");

			// 3. 0.3 秒後恢復原狀
			setTimeout(() => {
				target.classList.remove("is-hit");
				Pos.isHit = false; // 🔥 解鎖：受擊時暫停移動與動k畫
			}, 500);
		}
		function spawnCounterEffect(x, y, targetId, Pos) {
			// 1. 產生視覺特效 (原本的)
			Pos.isHit = true; // 🔥 設置受擊狀態
			const effect = document.createElement("div");
			effect.className = "hit-effect";
			effect.style.left = x - 50 + "px";
			effect.style.top = y - 50 + "px";
			document.querySelector(".game-board").appendChild(effect);
			setTimeout(() => effect.remove(), 300);

			// 2. 切換圖片狀態
			const target = document.getElementById(targetId);
			target.classList.add("is-hit");

			// 3. 0.3 秒後恢復原狀
			setTimeout(() => {
				target.classList.remove("is-hit");
				Pos.isHit = false; // 🔥 解鎖：受擊時暫停移動與動k畫
			}, 2000);
		}
		// 3. 攻擊與碰撞系統 (邏輯保持你的優化版) KICK
		function setupAttack_kick(htbox, boxId, atkId, key, direction, pos) {
			const box = document.getElementById(boxId);
			const hbox = document.getElementById(htbox);
			const atk = document.getElementById(atkId);
			const counter = document.getElementById(
				boxId === "box1" ? "counter1" : "counter2",
			);
			let attacking = false;
			let attackWindow = false;

			window.addEventListener("keydown", (e) => {
				if (pos.isHit) return;
				if (e.key.toLowerCase() === key && !attacking) {
					const now = performance.now();
					if (now - pos.lastAttackTime < 600) return;
					pos.lastAttackTime = now;
					attackWindow = false;
					pos.isLocked = true; // 🔥 強制鎖定：此時 updateBox 將無法移動
					attacking = true;
					playSound("src/components/fighter_game/src/kick/1.wav");
					// 0. 記錄原始位置
					const originalX = pos.x;
					const dashDistance = 119; // 想要瞬移的距離

					// 1. 瞬間移動：攻擊開始時直接增加座標
					pos.x +=
						direction === "right" ? dashDistance : -dashDistance;
					box.style.left = pos.x + "px";

					box.classList.add("is-kicking");

					// 2. 動畫結束後瞬間傳送回來
					setTimeout(() => {
						hbox.style.display = "none"; // 確保攻擊判定盒在攻擊結束後隱藏
						counter?.classList.remove("active");
						// 瞬間傳送回原位
						pos.x = originalX;
						box.style.left = pos.x + "px";

						atk.style.display = "none";
						box.classList.remove("is-attacking");
						box.classList.remove("is-walking");
						box.classList.remove("is-kicking");

						box.style.animation = "none";
						box.offsetHeight;
						box.style.animation = "";
						attacking = false;
						pos.isLocked = false; // 🔥 解鎖：攻擊結束後恢復移動能力
						hbox.style.display = "block"; // 確保攻擊判定盒在攻擊結束後隱藏
					}, 499); // 與 CSS 動畫長度對應

					// 攻擊判定盒出現
					setTimeout(() => {
						if (attacking) {
							atk.style.display = "block";
							counter?.classList.add("active");
							attackWindow = true;
						}
					}, 200);
					setTimeout(() => {
						if (attacking) {
							counter?.classList.remove("active");
							attackWindow = false;
						}
					}, 210);
				}
			});

			// 追蹤器維持不變
			function follow() {
				atk.style.left =
					(direction === "right" ? pos.x + 199 : pos.x) + "px";
				atk.style.top = pos.y + 209 + "px";
				requestAnimationFrame(follow);
			}
			follow();
		}
		// 2. 攻擊與碰撞系統 (邏輯保持你的優化版)
		function setupAttack(boxId, atkId, key, direction, pos) {
			if (pos.isHit) return;

			const box = document.getElementById(boxId);
			const atk = document.getElementById(atkId);
			const counter = document.getElementById(
				boxId === "box1" ? "counter1" : "counter2",
			);

			let startTime = 0;

			window.addEventListener("keydown", (e) => {
				if (pos.isHit || pos.isLocked) return;
				if (e.key.toLowerCase() === key && !pos.isLocked) {
					const now = performance.now();
					if (now - pos.lastAttackTime < 600) return;
					pos.lastAttackTime = now;
					pos.isLocked = true;
					startTime = performance.now(); // 🔥 這裡必須更新 startTime

					// ... (原本的音效與瞬間移動邏輯保持不變)
					pos.isLocked = true;
					playSound("src/components/fighter_game/src/attack/1.wav");

					const originalX = pos.x;
					pos.x += direction === "right" ? 79 : -79;
					box.style.left = pos.x + "px";
					box.classList.add("is-attacking");

					setTimeout(() => {
						pos.x = originalX;
						box.style.left = pos.x + "px";
						atk.style.display = "none";
						counter?.classList.remove("active");
						box.classList.remove("is-attacking");
						pos.isLocked = false;
					}, 400);
				}
			});

			function follow(now) {
				if (pos.isLocked) {
					const elapsed = now - startTime;

					// 1. 控制攻擊盒的顯示與偏移
					let kickExtension = 0;

					if (elapsed < 100) {
						atk.style.display = "none"; // 蓄力階段不顯示
						counter?.classList.remove("active");
					} else if (elapsed >= 100 && elapsed < 280) {
						atk.style.display = "block"; // 踢擊階段顯示
						counter?.classList.add("active");
						kickExtension =
							pos.heartBar === "heart1-bar" ? 30 : -200; // 根據玩家不同增加額外距離
					} else {
						atk.style.display = "none"; // 收回階段隱藏
						counter?.classList.remove("active");
					}

					// 2. 計算 X 軸位置
					const baseOffset = direction === "right" ? 209 : 20;
					const finalX =
						direction === "right"
							? pos.x + baseOffset + kickExtension
							: pos.x - 180 - kickExtension;

					atk.style.left = finalX + "px";
					atk.style.top = pos.y + 199 + "px";
				} else {
					// 非攻擊狀態強制隱藏
					atk.style.display = "none";
				}

				requestAnimationFrame(follow);
			}
			requestAnimationFrame(follow);
		}

		function preventCollision(aId, bId, posA, posB) {
			const a = document.getElementById(aId).querySelector(".hitbox");
			const b = document.getElementById(bId).querySelector(".hitbox");

			function loop() {
				const r1 = a.getBoundingClientRect();
				const r2 = b.getBoundingClientRect();

				if (
					r1.left < r2.right &&
					r1.right > r2.left &&
					r1.top < r2.bottom &&
					r1.bottom > r2.top
				) {
					const dx =
						r1.left + r1.width / 2 - (r2.left + r2.width / 2);
					const overlapX = r1.width / 2 + r2.width / 2 - Math.abs(dx);
					const push = overlapX / 2;
					if (dx > 0) {
						posA.x += push;
						posB.x -= push;
					} else {
						posA.x -= push;
						posB.x += push;
					}
				}
				requestAnimationFrame(loop);
			}
			loop();
		}

		function hitCheck(atkId, targetId) {
			const atk = document.getElementById(atkId);
			const target = document.getElementById(targetId);
			if (atk.style.display !== "block") return false;
			const ra = atk.getBoundingClientRect();
			const rt = target.getBoundingClientRect();
			return (
				ra.left < rt.right &&
				ra.right > rt.left &&
				ra.top < rt.bottom &&
				ra.bottom > rt.top
			);
		}

		// 4. 遊戲主迴圈
		// 攻擊冷卻追蹤 (防止同一攻擊在多幀內重複觸發傷害)
		const attackCooldown = {
			attack1: 0,
			attack_kick1: 0,
			attack2: 0,
			attack_kick2: 0,
		};
		const COOLDOWN_MS = 50; // 50ms 冷卻時間

		function gameLoop() {
			updateBox("box1", { left: "a", right: "d" }, p1);
			updateBox("box2", { left: "j", right: "l" }, p2);
			const now = performance.now();

			// ========== 玩家2 受傷檢查 ==========
			if (p2.isInvincible === false) {
				// 優先度 1: 懲罰反擊 (擊中 counter2)
				if (
					(hitCheck("attack1", "counter2") &&
						now - attackCooldown.attack1 > COOLDOWN_MS) ||
					(hitCheck("attack_kick1", "counter2") &&
						now - attackCooldown.attack_kick1 > COOLDOWN_MS)
				) {
					console.log("玩家1觸發懲罰反擊！玩家1扣血！");
					spawnCounterEffect(p1.x + 200, p1.y + 200, "box1", p1);
					subHearts(p1); // 玩家1受罰
					attackCooldown.attack1 = now;
					attackCooldown.attack_kick1 = now;
				}
				// 優先度 2: 相互攻擊 (攻擊互相碰撞)
				else if (
					(hitCheck("attack1", "attack2") &&
						now - attackCooldown.attack1 > COOLDOWN_MS) ||
					(hitCheck("attack1", "attack_kick2") &&
						now - attackCooldown.attack1 > COOLDOWN_MS) ||
					(hitCheck("attack_kick1", "attack2") &&
						now - attackCooldown.attack_kick1 > COOLDOWN_MS) ||
					(hitCheck("attack_kick1", "attack_kick2") &&
						now - attackCooldown.attack_kick1 > COOLDOWN_MS &&
						p2.isLocked === true)
				) {
					console.log("攻擊相互碰撞！雙方都扣血！");
					spawnCounterEffect(p2.x + 200, p2.y + 200, "box2", p2);
					conunterHearts(p1); // 玩家1獲得加成
					subHearts(p2); // 玩家2扣血
					attackCooldown.attack1 = now;
					attackCooldown.attack_kick1 = now;
				}
				// 優先度 3: 正常命中 (擊中 hitbox2)
				else if (
					(hitCheck("attack1", "hitbox2") &&
						now - attackCooldown.attack1 > COOLDOWN_MS) ||
					(hitCheck("attack_kick1", "hitbox2") &&
						now - attackCooldown.attack_kick1 > COOLDOWN_MS)
				) {
					console.log("玩家1攻擊命中玩家2！");
					subHearts(p2);
					spawnHitEffect(p2.x + 200, p2.y + 200, "box2", p2);
					attackCooldown.attack1 = now;
					attackCooldown.attack_kick1 = now;
				}
			}

			// ========== 玩家1 受傷檢查 ==========
			if (p1.isInvincible === false) {
				// 優先度 1: 懲罰反擊 (擊中 counter1)
				if (
					(hitCheck("attack2", "counter1") &&
						now - attackCooldown.attack2 > COOLDOWN_MS) ||
					(hitCheck("attack_kick2", "counter1") &&
						now - attackCooldown.attack_kick2 > COOLDOWN_MS)
				) {
					console.log("玩家2觸發懲罰反擊！玩家2扣血！");
					spawnCounterEffect(p2.x + 200, p2.y + 200, "box2", p2);
					subHearts(p2); // 玩家2受罰
					attackCooldown.attack2 = now;
					attackCooldown.attack_kick2 = now;
				}
				// 優先度 2: 相互攻擊 (攻擊互相碰撞)
				else if (
					(hitCheck("attack2", "attack1") &&
						now - attackCooldown.attack2 > COOLDOWN_MS) ||
					(hitCheck("attack2", "attack_kick1") &&
						now - attackCooldown.attack2 > COOLDOWN_MS) ||
					(hitCheck("attack_kick2", "attack1") &&
						now - attackCooldown.attack_kick2 > COOLDOWN_MS) ||
					(hitCheck("attack_kick2", "attack_kick1") &&
						now - attackCooldown.attack_kick2 > COOLDOWN_MS &&
						p1.isLocked === true)
				) {
					console.log("攻擊相互碰撞！雙方都扣血！");
					spawnCounterEffect(p1.x + 200, p1.y + 200, "box1", p1);
					conunterHearts(p2); // 玩家2獲得加成
					subHearts(p1); // 玩家1扣血
					attackCooldown.attack2 = now;
					attackCooldown.attack_kick2 = now;
				}
				// 優先度 3: 正常命中 (擊中 hitbox1)
				else if (
					(hitCheck("attack2", "hitbox1") &&
						now - attackCooldown.attack2 > COOLDOWN_MS) ||
					(hitCheck("attack_kick2", "hitbox1") &&
						now - attackCooldown.attack_kick2 > COOLDOWN_MS)
				) {
					console.log("玩家2攻擊命中玩家1！");
					subHearts(p1);
					spawnHitEffect(p1.x + 200, p1.y + 200, "box1", p1);
					attackCooldown.attack2 = now;
					attackCooldown.attack_kick2 = now;
				}
			}
			// if (
			// 	attack1.style.display === "none" ||
			// 	attack_kick1.style.display === "none"
			// ) {
			// 	player1Gethit = false;
			// }
			requestAnimationFrame(gameLoop);
		}

		// 5. 執行初始化
		setupAttack("box1", "attack1", "s", "right", p1);
		setupAttack_kick("hitbox1", "box1", "attack_kick1", "w", "right", p1);
		setupStepMove("box1", "a", "d", p1);
		setupStepMove("box2", "j", "l", p2);
		setupAttack("box2", "attack2", "k", "left", p2);
		setupAttack_kick("hitbox2", "box2", "attack_kick2", "i", "left", p2);
		preventCollision("box1", "box2", p1, p2);
		gameLoop();
		(function () {
			let debugOn = false;
			const btn = document.getElementById("debugBtn");
			const style = document.createElement("style");
			style.id = "debugStyle";
			document.head.appendChild(style);

			btn.addEventListener("click", () => {
				debugOn = !debugOn;
				btn.textContent = debugOn ? "[ DEBUG: ON  ]" : "[ DEBUG: OFF ]";
				btn.style.color = debugOn ? "#ff0" : "#0ff";
				btn.style.borderColor = debugOn ? "#ff0" : "#0ff";
				style.textContent = debugOn
					? `
      .hitbox   { background: rgba(255,0,0,0.35) !important; }
      .counter-hitbox { display:block !important; background:rgba(0,255,0,0.25) !important; border:2px solid rgba(0,255,0,0.8) !important; }
      .attack   { background: rgba(241,196,15,0.55) !important; }
      .attack2  { background: rgba(241,100,15,0.55) !important; }
    `
					: "";
			});
		})();
	</script>
