---
// src/components/TopBar.astro
const { brandName = "MyWebsite" } = Astro.props;

// 導覽列的選單資料
const navItems = [
  { text: "首頁", href: "/" },
  { text: "關於我們", href: "/demo" },
  { text: "最新消息", href: "/news" },
  { text: "聯絡我們", href: "/contact" },
];
---

<header class="top-bar">
  <div class="container">
    <!-- Logo 區域 -->
    <a href="/" class="brand">{brandName}</a>

    <!-- 導覽選單 -->
    <nav class="nav-links">
      {navItems.map((item) => (
        <a href={item.href}>{item.text}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  /* 頂部導覽列主體 */
  .top-bar {
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  /* 限制最大寬度並置中 */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* Logo 樣式 */
  .brand {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1f2937;
    text-decoration: none;
    letter-spacing: -0.025em;
  }

  /* 選單連結區塊 */
  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  /* 單個連結樣式 */
  .nav-links a {
    color: #4b5563;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  /* 滑鼠懸停效果 */
  .nav-links a:hover {
    color: #2563eb; /* 現代感藍色 */
  }

  /* 手機版簡單適應（選單字體縮小、間距變窄） */
  @media (max-width: 640px) {
    .container {
      padding: 0 1rem;
    }
    .nav-links {
      gap: 1rem;
    }
    .nav-links a {
      font-size: 0.875rem;
    }
  }
</style>