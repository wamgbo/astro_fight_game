---
// Astro 伺服器端邏輯（Frontmatter）
// 這裡目前不需要處理額外的資料，保持乾淨即可
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
		<div class="score-board">
    		<span id="score1">0</span> : <span id="score2">0</span>
		</div>
		<div class="game-board">
			<div id="box1" class="rectangle"></div>
			<div id="ball"></div>
			<div id="box2" class="rectangle"></div>
		</div>
	</body>
</html>

<script>
    // 封裝成可以重複利用的控制函式
    function setupPaddleControl(boxId, upKey, downKey, initialTop) {
        const box = document.getElementById(boxId);
        const board = document.querySelector(".game-board");

        if (!box || !board) return;

        let currentTop = initialTop;
        const speed = 8;

        // 該玩家專屬的按鍵狀態記錄
        const keysPressed = {
            [upKey]: false,
            [downKey]: false
        };

        window.addEventListener("keydown", (event) => {
            const presskey = event.key.toLowerCase();
            if (presskey in keysPressed) {
                // 防止按上下鍵時，瀏覽器網頁跟著捲動
                if (presskey.startsWith("arrow")) {
                    event.preventDefault();
                }
                keysPressed[presskey] = true;
            }
        });

        window.addEventListener("keyup", (event) => {
            const presskey = event.key.toLowerCase();
            if (presskey in keysPressed) {
                keysPressed[presskey] = false;
            }
        });

        function updatePosition() {
            if (keysPressed[upKey]) {
                currentTop -= speed;
            }
            if (keysPressed[downKey]) {
                currentTop += speed;
            }

            // 邊界限制碰撞偵測
            const maxTop = board.clientHeight - box.clientHeight;
            if (currentTop < 0) currentTop = 0;
            if (currentTop > maxTop) currentTop = maxTop;

            // 更新實際位置
            box.style.top = currentTop + "px";

            requestAnimationFrame(updatePosition);
        }

        requestAnimationFrame(updatePosition);
    }
    function initBallControl() {
        const ball = document.getElementById("ball");
        const board = document.querySelector(".game-board");
		const box1 = document.getElementById("box1");
		const box2 = document.getElementById("box2");
		const score1 = document.getElementById("score1");
		const score2 = document.getElementById("score2");
        if (!ball || !board) return;

        // 1. 設定球的初始坐標 (X軸與Y軸)
        let ballX = 600; 
        let ballY = 350;

        // 2. 設定球的移動速度 (像素/幀)
        let speedX = 5; // 正數往右，負數往左
        let speedY = 4; // 正數往下，負數往上

        // 3. 自動飛行迴圈
        function moveBall() {
            // 讓坐標不斷累加速度
            ballX += speedX;
            ballY += speedY;

            // 🛑 上下牆壁碰撞偵測
            const maxBallY = board.clientHeight - ball.clientHeight;
            if (ballY <= 0 || ballY >= maxBallY) {
                speedY = -speedY; // Y軸速度正負反轉（達成上下反彈）
            }

            // 🛑 左右牆壁碰撞偵測 (目前先做單純反彈，之後可改為得分邏輯)
            const maxBallX = board.clientWidth - ball.clientWidth;
            if (ballX <= 0 || ballX >= maxBallX) {
				ballX = 600;      // 瞬間移回中央（視覺上等於在邊界消失）
    			ballY = 350;
				// 🔥 隨機方向 (正負號)：決定往左/右、往上/下
    			const dirX = Math.random() > 0.5 ? 1 : -1;
    			const dirY = Math.random() > 0.5 ? 1 : -1;

    			// 🔥 隨機速率：X 軸速度在 4 ~ 8 之間，Y 軸速度在 3 ~ 6 之間
    			speedX = (2 + Math.random() * 1) * dirX;
    			speedY = (2 + Math.random() * 1) * dirY;
				// 🔥 更新分數
				if (ballX <= 0) {
					score2.textContent = parseInt(score2.textContent) + 1;
				} else {
					score1.textContent = parseInt(score1.textContent) + 1;
				}
            }

            // 4. 將計算好的新位置更新到 CSS
            ball.style.left = ballX + "px";
            ball.style.top = ballY + "px";
			let b1 = box1.getBoundingClientRect();
            let b2 = box2.getBoundingClientRect();
            let ballRect = ball.getBoundingClientRect();

			if (
                ballRect.left <= b1.right &&    // 球的左邊界 超過 板子的右邊界
                ballRect.right >= b1.left &&    // 球的右邊界 超過 板子的左邊界
                ballRect.top <= b1.bottom &&    // 球的頂部 超過 板子的底部
                ballRect.bottom >= b1.top       // 球的底部 超過 板子的頂部
            ) {
                // 為了防止球卡在板子裡，強制把球推到板子右側外一點點
                ballX = box1.offsetLeft + box1.clientWidth;
                speedX = -speedX; // X 軸速度反轉，彈開！
            }

            // 🔥 4. 碰撞偵測：檢查球有沒有撞到 box2 (右板子)
            if (
                ballRect.left <= b2.right &&
                ballRect.right >= b2.left &&
                ballRect.top <= b2.bottom &&
                ballRect.bottom >= b2.top
            ) {
                // 強制把球推到右板子的左側外
                ballX = box2.offsetLeft - ball.clientWidth;
                speedX = -speedX; // X 軸速度反轉，彈開！
            }
            // 持續循環
            requestAnimationFrame(moveBall);
        }

        // 啟動飛行
        requestAnimationFrame(moveBall);
    }

    // 呼叫執行
    initBallControl();
    // 🔥 初始化：分別設定 P1（左）與 P2（右）的控制按鍵與初始高度
    setupPaddleControl("box1", "w", "s", 100);
    setupPaddleControl("box2", "arrowup", "arrowdown", 100);
</script>

