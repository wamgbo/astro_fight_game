---
// src/pages/login.astro
import Layout from "../layouts/Layout.astro";
export const prerender = false;
const sessionCookie = Astro.cookies.get("user_session");

// 🔥 使用 console.log 輸出到終端機
console.log("--- 檢查單一 Cookie 物件 ---");
console.log("是否存在:", Astro.cookies.has("user_session"));
console.log("Cookie 的純字串值:", sessionCookie?.value);
console.log("完整的 Cookie 紀錄:", sessionCookie);

let errorMessage = "";

if (Astro.request.method === "POST") {
	try {
		let username = "";
		let password = "";

		// 🔍 檢查前端送過來的資料類型 (Content-Type)
		const contentType = Astro.request.headers.get("content-type") || "";

		if (contentType.includes("application/json")) {
			// 💡 情況 1：如果前端是用 fetch/axios 送出 JSON 格式
			const body = await Astro.request.json();
			username = body.username;
			password = body.password;
		} else if (
			contentType.includes("application/x-www-form-urlencoded") ||
			contentType.includes("multipart/form-data")
		) {
			// 💡 情況 2：如果是傳統 HTML 原生表單格式
			const data = await Astro.request.formData();
			username = data.get("username")?.toString() || "";
			password = data.get("password")?.toString() || "";
		} else {
			// 💡 情況 3：完全沒帶 Content-Type（某些特殊的 fetch 寫法）
			// 嘗試用文字解析看看
			try {
				const text = await Astro.request.text();
				const params = new URLSearchParams(text);
				username = params.get("username") || "";
				password = params.get("password") || "";
			} catch (e) {
				// 如果連文字都解析失敗，再嘗試當成 JSON 盲猜
				const body = JSON.parse(await Astro.request.text());
				username = body.username;
				password = body.password;
			}
		}

		// 🔒 驗證帳密 (測試期間 || true 保持開啟)
		if ((username === "admin" && password === "123456") || true) {
			const sessionToken = "user_secret_token_abc123";

			// 寫入 Cookie 記住登入狀態
			Astro.cookies.set("user_session", sessionToken, {
				path: "/",
				httpOnly: true,
				secure: true,
				maxAge: 60 * 60 * 24 * 7,
			});

			return Astro.redirect("/");
		} else {
			errorMessage = "帳號或密碼錯誤！";
		}
	} catch (error) {
		console.error("【後端解析徹底失敗】:", error);
		errorMessage = "登入失敗，請檢查輸入格式。";
	}
}
---

<Layout>
	<div class="login-container">
		<h2>登入開始遊戲</h2>

		<form method="POST">
			{errorMessage && <p class="error-msg">{errorMessage}</p>}

			<div class="input-group">
				<input
					type="text"
					id="username"
					name="username"
					placeholder="請輸入帳號 (admin)"
					required
				/>
			</div>

			<div class="input-group">
				<input
					type="password"
					id="password"
					name="password"
					placeholder="請輸入密碼 (123456)"
					required
				/>
			</div>

			<button type="submit">登入</button>
		</form>
	</div>
</Layout>

<style>
	.login-container {
		background: #ffffff;
		padding: 2.5rem;
		border-radius: 12px;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
		width: 100%;
		max-width: 400px;
		margin: 100px auto;
		text-align: center;
		font-family: sans-serif;
	}

	h2 {
		margin-bottom: 2rem;
		color: #2c3e50;
	}

	.input-group {
		margin-bottom: 1.25rem;
	}

	input {
		width: 100%;
		padding: 0.8rem;
		border: 2px solid #e5e7eb;
		border-radius: 6px;
		font-size: 1rem;
		outline: none;
	}

	input:focus {
		border-color: #3498db;
	}

	button {
		width: 100%;
		padding: 0.8rem;
		background-color: #2ecc71;
		color: white;
		border: none;
		border-radius: 6px;
		font-size: 1rem;
		font-weight: bold;
		cursor: pointer;
	}

	button:hover {
		background-color: #27ae60;
	}

	.error-msg {
		color: #e74c3c;
		background-color: #fde8e8;
		padding: 0.6rem;
		border-radius: 6px;
		font-size: 0.9rem;
		margin-bottom: 1rem;
		font-weight: bold;
	}
</style>
