<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <title>100% 絕對看得到的 CRT 特效</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body, html { 
            width: 100%; 
            height: 100%; 
            overflow: hidden; 
            background-color: #000; 
            display: flex;
            justify-content: center;
            align-items: center;
        }
        /* 模擬一個老舊電視機的外框 */
        #tv-case {
            width: 90vw;
            height: 80vh;
            background: #1a1a1a;
            border: 20px solid #2a2a2a;
            border-radius: 40px;
            box-shadow: inset 0 0 30px #000, 0 10px 50px rgba(0,0,0,0.8);
            position: relative;
            overflow: hidden;
        }
        canvas {
            width: 100%;
            height: 100%;
            display: block;
        }
    </style>
</head>
<body>

    <div id="tv-case">
        <canvas id="crtCanvas"></canvas>
    </div>

    <script>
        const canvas = document.getElementById('crtCanvas');
        const ctx = canvas.getContext('2d');

        // 讓 Canvas 的解析度與實際螢幕大小同步
        function resize() {
            canvas.width = canvas.clientWidth;
            canvas.height = canvas.clientHeight;
        }
        resize();
        window.addEventListener('resize', resize);

        let frame = 0;

        function draw() {
            frame++;
            const w = canvas.width;
            const h = canvas.height;

            // 1. 清空畫布，填滿黑客綠的暗底
            ctx.fillStyle = '#051a05';
            ctx.fillRect(0, 0, w, h);

            // 2. 畫一些經典的復古綠色雷達線條與圖形（模擬舊螢幕內容）
            ctx.strokeStyle = '#00ff33';
            ctx.lineWidth = 2;
            ctx.shadowBlur = 10;
            ctx.shadowColor = '#00ff33';

            // 畫個網格
            ctx.beginPath();
            for(let i = 0; i < w; i += 40) {
                ctx.moveTo(i, 0); ctx.lineTo(i, h);
            }
            for(let j = 0; j < h; j += 40) {
                ctx.moveTo(0, j); ctx.lineTo(w, j);
            }
            ctx.strokeStyle = 'rgba(0, 255, 51, 0.15)';
            ctx.stroke();

            // 畫個旋轉的雷達掃描線
            ctx.beginPath();
            ctx.arc(w/2, h/2, h/3, 0, Math.PI * 2);
            ctx.strokeStyle = '#00ff33';
            ctx.stroke();

            ctx.beginPath();
            ctx.moveTo(w/2, h/2);
            ctx.lineTo(
                w/2 + Math.cos(frame * 0.02) * (h/3), 
                h/2 + Math.sin(frame * 0.02) * (h/3)
            );
            ctx.stroke();

            // 畫上復古大字
            ctx.fillStyle = '#00ff33';
            ctx.font = 'bold 36px monospace';
            ctx.textAlign = 'center';
            ctx.fillText("CRT MONITOR ACTIVE", w / 2, h / 2 - 20);

            // 關閉影子，開始畫「電視缺陷特效」，否則會太卡
            ctx.shadowBlur = 0;

            // 3. 【核心特效：掃描線與電波】
            // 透過像素級的疊加，強制在畫面上蓋出橫條紋
            ctx.fillStyle = 'rgba(0, 0, 0, 0.3)';
            for (let y = 0; y < h; y += 4) {
                ctx.fillRect(0, y, w, 2); // 每隔 4 像素畫一條 2 像素寬的黑線
            }

            // 4. 【核心特效：滾動雜訊帶】
            // 模擬電視訊號不穩，一條橫向的亮帶緩慢往下滾動
            let noiseY = (frame * 2) % h;
            ctx.fillStyle = 'rgba(255, 255, 255, 0.06)';
            ctx.fillRect(0, noiseY, w, 50);

            // 5. 【核心特效：全螢幕微弱閃爍】
            if (Math.random() > 0.95) {
                ctx.fillStyle = 'rgba(0, 255, 51, 0.04)';
                ctx.fillRect(0, 0, w, h);
            }

            // 6. 【核心特效：球面邊角陰影】
            // 用漸層做出螢幕四周變暗、像大頭電視凸起來的視覺感
            let gradient = ctx.createRadialGradient(w/2, h/2, h/3, w/2, h/2, w*0.6);
            gradient.addColorStop(0, 'rgba(0,0,0,0)');
            gradient.addColorStop(1, 'rgba(0,0,0,0.8)');
            ctx.fillStyle = gradient;
            ctx.fillRect(0, 0, w, h);

            requestAnimationFrame(draw);
        }

        draw();
    </script>
</body>
</html>